# ---- required ---------------------------------------------------------------
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_VOICE_API_KEY=
OPENAI_API_KEY=

# ---- phone (Plivo) — fill in, then run: python -m supplier_caller.setup_sip --
PLIVO_TRUNK_DOMAIN=<trunk_id>.zt.plivo.com
PLIVO_SIP_USERNAME=
PLIVO_SIP_PASSWORD=
PLIVO_NUMBER=+1XXXXXXXXXX
SIP_OUTBOUND_TRUNK_ID=            # written by setup_sip

# ---- optional — uncomment to override the default shown --------------------
# CALLER_LLM=gpt-4.1                # model on the call
# AUDIT_LLM=gpt-4.1                 # after-call second opinion
# STT_MODEL=nova-3
# STT_LANGUAGE=en                   # multi = auto-detect language per utterance (drops keyterm boosting)
# CALLER_VOICE=aura-2-thalia-en
# VAD_ACTIVATION=0.6                # raise to ignore more background noise, lower if it misses quiet speakers
# MIN_INTERRUPTION_SECONDS=0.6      # speech needed before the agent stops talking
# MIN_INTERRUPTION_WORDS=2          # ...and at least this many transcribed words
# FALSE_INTERRUPTION_TIMEOUT=1.5    # cut off but nothing intelligible for this long → resume speaking
# HOLD_CHECKIN_AFTER=150            # seconds on hold before one "still here"
# HOLD_GIVE_UP_AFTER=300            # seconds on hold before hanging up
# MAX_CALL_SECONDS=360
# CALLEE_JOIN_TIMEOUT=90            # seconds to wait for the phone to be answered
# PORT=8000                         # web UI
